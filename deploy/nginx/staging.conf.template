# REVIEW ONLY. Install alongside existing vhosts only after VPS inspection.
# Copy *.inc to /etc/nginx/maqamstay after approval; certificates must already exist.
server {
    listen 80;
    server_name staging.maqamstay.com admin-staging.maqamstay.com inventory-api-staging.maqamstay.com;
    return 308 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name staging.maqamstay.com;
    ssl_certificate /etc/letsencrypt/live/staging.maqamstay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/staging.maqamstay.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
    }
}
server {
    listen 443 ssl;
    server_name admin-staging.maqamstay.com;
    ssl_certificate /etc/letsencrypt/live/admin-staging.maqamstay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/admin-staging.maqamstay.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 9m;
    location / {
        proxy_pass http://127.0.0.1:3100;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_read_timeout 60s;
    }
}
server {
    listen 443 ssl;
    server_name inventory-api-staging.maqamstay.com;
    ssl_certificate /etc/letsencrypt/live/inventory-api-staging.maqamstay.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/inventory-api-staging.maqamstay.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    include /etc/nginx/maqamstay/catalog-routes.inc;
}
