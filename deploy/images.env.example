# Customer-only selector template for /opt/maqamstay-staging/deployment/customer-images.env.
# Actual digests come from GHCR evidence. Never overwrite the live file with this example.
CUSTOMER_IMAGE=ghcr.io/shhassan699-maker/maqamstay-customer@sha256:REPLACE_WITH_DIGEST
CUSTOMER_RELEASE_IMAGE=ghcr.io/shhassan699-maker/maqamstay-customer-release@sha256:REPLACE_WITH_DIGEST
CUSTOMER_ENV_FILE=/etc/maqamstay-staging/customer.env
CUSTOMER_RELEASE_ENV_FILE=/etc/maqamstay-staging/customer-release.env
POSTGRES_ENV_FILE=/etc/maqamstay-staging/postgres.env
