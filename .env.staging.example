# Provider-neutral customer deployment template. Inject secrets at runtime.
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://maqamstay-staging.169-58-95-12.sslip.io
CUSTOMER_CRM_ORIGIN=https://maqamstay-crm.169-58-95-12.sslip.io
DATABASE_URL=postgresql://CUSTOMER_RUNTIME_USER:ENCODED_PASSWORD@postgres:5432/customer_staging?sslmode=disable
SESSION_SECRET=REPLACE_WITH_CUSTOMER_SESSION_SECRET
NEXT_PUBLIC_WHATSAPP_NUMBER=CONFIGURED_SUPPORT_NUMBER
INVENTORY_API_URL=https://inventory-api-staging.maqamstay.com
INVENTORY_CATALOG_API_KEY=REPLACE_WITH_CATALOG_READ_KEY_FROM_INVENTORY_ADMIN
INVENTORY_TIMEOUT_MS=5000

# sslmode=disable is for the private local Docker DB network only. External DBs require verified TLS.
